/* -------------------- 自定义堆栈 -------------------- */
typedef struct {
    double data[MAX_STACK];
    int top;
} NumberStack;

typedef struct {
    char data[MAX_STACK];
    int top;
} OperatorStack;

void initNumberStack(NumberStack* s) { s->top = -1; }
int numberEmpty(const NumberStack* s) { return s->top == -1; }
int numberFull(const NumberStack* s) { return s->top >= MAX_STACK - 1; }
int pushNumber(NumberStack* s, double value) {
    if (numberFull(s)) return 0;
    s->data[++s->top] = value;
    return 1;
}
int popNumber(NumberStack* s, double* value) {
    if (numberEmpty(s)) return 0;
    *value = s->data[s->top--];
    return 1;
}
int peekNumber(const NumberStack* s, double* value) {
    if (numberEmpty(s)) return 0;
    *value = s->data[s->top];
    return 1;
}

void initOperatorStack(OperatorStack* s) { s->top = -1; }
int operatorEmpty(const OperatorStack* s) { return s->top == -1; }
int operatorFull(const OperatorStack* s) { return s->top >= MAX_STACK - 1; }
int pushOperator(OperatorStack* s, char op) {
    if (operatorFull(s)) return 0;
    s->data[++s->top] = op;
    return 1;
}
int popOperator(OperatorStack* s, char* op) {
    if (operatorEmpty(s)) return 0;
    *op = s->data[s->top--];
    return 1;
}
int peekOperator(const OperatorStack* s, char* op) {
    if (operatorEmpty(s)) return 0;
    *op = s->data[s->top];
    return 1;
}

/* -------------------- 表达式检查与求值 -------------------- */
static int isBinaryOperator(char c) {
    return c == '+' || c == '-' || c == '*' || c == '/';
}
static int precedence(char op) {
    if (op == '+' || op == '-') return 1;
    if (op == '*' || op == '/') return 2;
    return 0;
}
static int applyOperation(NumberStack* nums, char op) {
    double a, b, result;
    if (!popNumber(nums, &b) || !popNumber(nums, &a)) return 0;
    switch (op) {
    case '+': result = a + b; break;
    case '-': result = a - b; break;
    case '*': result = a * b; break;
    case '/':
        if (fabs(b) < 1e-12) return -1;
        result = a / b; break;
    default: return 0;
    }
    if (!isfinite(result)) return -1;
    return pushNumber(nums, result);
}

/* 支持多位数、小数、括号、四则运算及一元正负号 */
static int evaluateExpression(const char* src, double* answer, const char** error) {
    NumberStack nums;
    OperatorStack ops;
    size_t i = 0, len = strlen(src);
    int expectValue = 1;
    initNumberStack(&nums);
    initOperatorStack(&ops);
    *error = "表达式格式错误";
    if (len == 0) { *error = "请输入表达式"; return 0; }

    while (i < len) {
        char c = src[i];
        if (isspace((unsigned char)c)) { i++; continue; }

        if (isdigit((unsigned char)c) || c == '.') {
            char* end;
            double value;
            if (!expectValue) { *error = "两个数字之间缺少运算符"; return 0; }
            if (c == '.') {
                size_t j = i + 1;
                if (j >= len || !isdigit((unsigned char)src[j])) {
                    *error = "小数点后必须有数字"; return 0;
                }
            }
            value = strtod(src + i, &end);
            if (end == src + i) { *error = "数字格式错误"; return 0; }
            /* 确保一个数字中不会出现第二个小数点，例如 1.2.3 */
            if (*end == '.') { *error = "一个数字不能有两个小数点"; return 0; }
            if (!isfinite(value) || !pushNumber(&nums, value)) {
                *error = "数字太大或表达式过长"; return 0;
            }
            i = (size_t)(end - src);
            expectValue = 0;
            continue;
        }

        if (c == '(') {
            if (!expectValue) { *error = "右括号或数字后不能直接输入左括号"; return 0; }
            if (!pushOperator(&ops, c)) { *error = "表达式过长"; return 0; }
            i++; expectValue = 1; continue;
        }

        if (c == ')') {
            char op;
            if (expectValue) { *error = "右括号位置不正确或括号中没有内容"; return 0; }
            while (peekOperator(&ops, &op) && op != '(') {
                popOperator(&ops, &op);
                if (applyOperation(&nums, op) <= 0) { *error = "计算错误（可能除数为零）"; return 0; }
            }
            if (!popOperator(&ops, &op) || op != '(') { *error = "左右括号不匹配"; return 0; }
            i++; expectValue = 0; continue;
        }

        if (isBinaryOperator(c)) {
            char topOp;
            if (expectValue) {
                /* 允许一元正负号，例如 -3、2*(-4)、-(2+3) */
                if (c == '+' || c == '-') {
                    if (c == '-') {
                        if (!pushNumber(&nums, 0.0)) { *error = "表达式过长"; return 0; }
                        /* 将一元负号转成 0-x；先压入减号，后续照常处理 */
                        while (peekOperator(&ops, &topOp) && topOp != '(' && precedence(topOp) >= precedence('-')) {
                            popOperator(&ops, &topOp);
                            if (applyOperation(&nums, topOp) <= 0) { *error = "计算错误"; return 0; }
                        }
                        if (!pushOperator(&ops, '-')) { *error = "表达式过长"; return 0; }
                    }
                    i++; expectValue = 1; continue;
                }
                *error = "两个运算符不能连续输入"; return 0;
            }
            while (peekOperator(&ops, &topOp) && topOp != '(' && precedence(topOp) >= precedence(c)) {
                popOperator(&ops, &topOp);
                {
                    int r = applyOperation(&nums, topOp);
                    if (r == -1) { *error = "除数不能为零"; return 0; }
                    if (r == 0) { *error = "表达式格式错误"; return 0; }
                }
            }
            if (!pushOperator(&ops, c)) { *error = "表达式过长"; return 0; }
            i++; expectValue = 1; continue;
        }
        *error = "存在不支持的字符";
        return 0;
    }

    if (expectValue) { *error = "表达式不能以运算符或左括号结束"; return 0; }
    while (!operatorEmpty(&ops)) {
        char op;
        popOperator(&ops, &op);
        if (op == '(') { *error = "左右括号不匹配"; return 0; }
        {
            int r = applyOperation(&nums, op);
            if (r == -1) { *error = "除数不能为零"; return 0; }
            if (r == 0) { *error = "表达式格式错误"; return 0; }
        }
    }
    if (nums.top != 0 || !popNumber(&nums, answer)) { *error = "表达式格式错误"; return 0; }
    return 1;
}

/* 检查当前输入框表达式是否可继续输入指定字符 */
static int canAppend(char ch) {
    size_t len = strlen(expression);
    char last = len ? expression[len - 1] : '\0';
    int depth = 0;
    size_t i;
    for (i = 0; i < len; ++i) {
        if (expression[i] == '(') depth++;
        else if (expression[i] == ')') depth--;
    }

    if (isdigit((unsigned char)ch)) {
        if (last == ')') return 0;
        return 1;
    }
    if (ch == '.') {
        size_t j = len;
        if (last == ')') return 0;
        while (j > 0 && (isdigit((unsigned char)expression[j - 1]) || expression[j - 1] == '.')) j--;
        if (j < len && memchr(expression + j, '.', len - j) != NULL) return 0;
        if (len == 0 || isBinaryOperator(last) || last == '(') return 0;
        return 1;
    }
    if (ch == '(') {
        if (len > 0 && (isdigit((unsigned char)last) || last == '.' || last == ')')) return 0;
        return 1;
    }
    if (ch == ')') {
        if (depth <= 0 || len == 0 || last == '(' || isBinaryOperator(last) || last == '.') return 0;
        return 1;
    }
    if (isBinaryOperator(ch)) {
        if (len == 0) return (ch == '+' || ch == '-');
        if (isBinaryOperator(last)) return 0;
        if (last == '(') return (ch == '+' || ch == '-');
        if (last == '.') return 0;
        return 1;
    }
    return 0;
}

static void setExpressionText(void) { SetWindowTextA(hDisplay, expression); }
static void showError(const char* msg) { MessageBoxA(NULL, msg, "输入或计算错误", MB_OK | MB_ICONWARNING); }

static void appendChar(char ch) {
    size_t len;
    /* 同步用户直接在输入框中键入的表达式 */
    GetWindowTextA(hDisplay, expression, MAX_EXPR);
    len = strlen(expression);
    if (justEvaluated) {
        if (isdigit((unsigned char)ch) || ch == '.' || ch == '(') expression[0] = '\0';
        justEvaluated = 0;
    }
    len = strlen(expression);
    if (len + 1 >= MAX_EXPR) { showError("表达式太长"); return; }
    if (!canAppend(ch)) { showError("输入不合法，请检查运算符、括号或小数点位置。"); return; }
    expression[len] = ch;
    expression[len + 1] = '\0';
    setExpressionText();
}

static void doBackspace(void) {
    size_t len = strlen(expression);
    if (len) expression[len - 1] = '\0';
    justEvaluated = 0;
    setExpressionText();
}

static void doClear(void) {
    expression[0] = '\0';
    justEvaluated = 0;
    setExpressionText();
}

static void doCalculate(void) {
    double result;
    const char* error;
    char out[128];
    const char* text;
    GetWindowTextA(hDisplay, expression, MAX_EXPR);
    if (!evaluateExpression(expression, &result, &error)) { showError(error); return; }
    /* 避免将普通结果显示成 2.000000 */
    snprintf(out, sizeof(out), "%.12g", result);
    text = out;
    SetWindowTextA(hDisplay, text);
    strncpy(expression, out, MAX_EXPR - 1);
    expression[MAX_EXPR - 1] = '\0';
    justEvaluated = 1;
}

static void addButton(HWND parent, const char* text, int id, int x, int y, int w, int h) {
    HWND b = CreateWindowA("BUTTON", text, WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON,
        x, y, w, h, parent, (HMENU)(INT_PTR)id, GetModuleHandle(NULL), NULL);
    SendMessage(b, WM_SETFONT, (WPARAM)hFontButton, TRUE);
}

static void setButtonColors(HWND hwnd) {
    (void)hwnd;
    /* 原生按钮采用系统主题；橙色运算符通过自绘界面简化兼容性。 */
}

static LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
    case WM_CREATE: {
        int x0 = 18, y0 = 116;
        hFontDisplay = CreateFontA(30, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY,
            DEFAULT_PITCH | FF_DONTCARE, "Segoe UI");
        hFontButton = CreateFontA(18, 0, 0, 0, FW_MEDIUM, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY,
            DEFAULT_PITCH | FF_DONTCARE, "Segoe UI");
        hDisplay = CreateWindowExA(WS_EX_CLIENTEDGE, "EDIT", "",
            WS_CHILD | WS_VISIBLE | ES_RIGHT | ES_AUTOHSCROLL,
            18, 20, 300, 72, hwnd, (HMENU)(INT_PTR)ID_DISPLAY, GetModuleHandle(NULL), NULL);
        SendMessage(hDisplay, WM_SETFONT, (WPARAM)hFontDisplay, TRUE);
        /* 布局：退格、清除、括号、除法；数字键与四则运算键 */
        addButton(hwnd, "C", ID_BASE + 0, x0, y0, BTN_W, BTN_H);
        addButton(hwnd, "DEL", ID_BASE + 1, x0 + (BTN_W + GAP), y0, BTN_W, BTN_H);
        addButton(hwnd, "(", ID_BASE + 2, x0 + 2 * (BTN_W + GAP), y0, BTN_W, BTN_H);
        addButton(hwnd, ")", ID_BASE + 3, x0 + 3 * (BTN_W + GAP), y0, BTN_W, BTN_H);

        addButton(hwnd, "7", ID_BASE + 7, x0, y0 + 1 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "8", ID_BASE + 8, x0 + (BTN_W + GAP), y0 + 1 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "9", ID_BASE + 9, x0 + 2 * (BTN_W + GAP), y0 + 1 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "/", ID_BASE + 10, x0 + 3 * (BTN_W + GAP), y0 + 1 * (BTN_H + GAP), BTN_W, BTN_H);

        addButton(hwnd, "4", ID_BASE + 4, x0, y0 + 2 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "5", ID_BASE + 5, x0 + (BTN_W + GAP), y0 + 2 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "6", ID_BASE + 6, x0 + 2 * (BTN_W + GAP), y0 + 2 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "*", ID_BASE + 11, x0 + 3 * (BTN_W + GAP), y0 + 2 * (BTN_H + GAP), BTN_W, BTN_H);

        addButton(hwnd, "1", ID_BASE + 1 + 20, x0, y0 + 3 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "2", ID_BASE + 2 + 20, x0 + (BTN_W + GAP), y0 + 3 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "3", ID_BASE + 3 + 20, x0 + 2 * (BTN_W + GAP), y0 + 3 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "-", ID_BASE + 12, x0 + 3 * (BTN_W + GAP), y0 + 3 * (BTN_H + GAP), BTN_W, BTN_H);

        addButton(hwnd, "0", ID_BASE + 13, x0, y0 + 4 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, ".", ID_BASE + 14, x0 + (BTN_W + GAP), y0 + 4 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "=", ID_BASE + 15, x0 + 2 * (BTN_W + GAP), y0 + 4 * (BTN_H + GAP), BTN_W, BTN_H);
        addButton(hwnd, "+", ID_BASE + 16, x0 + 3 * (BTN_W + GAP), y0 + 4 * (BTN_H + GAP), BTN_W, BTN_H);
        (void)setButtonColors;
        return 0;
    }
    case WM_COMMAND: {
        int id = LOWORD(wParam);
        char ch = '\0';
        if (id == ID_BASE + 0) { doClear(); return 0; }
        if (id == ID_BASE + 1) { doBackspace(); return 0; }
        if (id == ID_BASE + 2) ch = '(';
        else if (id == ID_BASE + 3) ch = ')';
        else if (id == ID_BASE + 4) ch = '4';
        else if (id == ID_BASE + 5) ch = '5';
        else if (id == ID_BASE + 6) ch = '6';
        else if (id == ID_BASE + 7) ch = '7';
        else if (id == ID_BASE + 8) ch = '8';
        else if (id == ID_BASE + 9) ch = '9';
        else if (id == ID_BASE + 10) ch = '/';
        else if (id == ID_BASE + 11) ch = '*';
        else if (id == ID_BASE + 12) ch = '-';
        else if (id == ID_BASE + 13) ch = '0';
        else if (id == ID_BASE + 14) ch = '.';
        else if (id == ID_BASE + 15) { doCalculate(); return 0; }
        else if (id == ID_BASE + 16) ch = '+';
        else if (id == ID_BASE + 21) ch = '1';
        else if (id == ID_BASE + 22) ch = '2';
        else if (id == ID_BASE + 23) ch = '3';
        if (ch) appendChar(ch);
        return 0;
    }
    case WM_KEYDOWN:
        if (wParam == VK_RETURN) { doCalculate(); return 0; }
        if (wParam == VK_ESCAPE) { doClear(); return 0; }
        if (wParam == VK_BACK) { doBackspace(); return 0; }
        break;
    case WM_DESTROY:
        if (hFontDisplay) DeleteObject(hFontDisplay);
        if (hFontButton) DeleteObject(hFontButton);
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProc(hwnd, msg, wParam, lParam);
}

int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int nCmdShow) {
    WNDCLASSA wc;
    HWND hwnd;
    MSG msg;
    (void)hPrevInstance; (void)lpCmdLine;
    memset(&wc, 0, sizeof(wc));
    wc.lpfnWndProc = WndProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = "CStackCalculatorWindow";
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    if (!RegisterClassA(&wc)) return 1;
    hwnd = CreateWindowA(wc.lpszClassName, "Calculator", WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX,
        CW_USEDEFAULT, CW_USEDEFAULT, 340, 510, NULL, NULL, hInstance, NULL);
    if (!hwnd) return 1;
    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);
    while (GetMessage(&msg, NULL, 0, 0) > 0) {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }
    return (int)msg.wParam;
}
